# ============================================================
# CONFIGURACIÓN DE ENTORNO - GANADEROS CAMPO PWA
# ============================================================
# Filosofía KISS: Para producción estándar solo necesitas definir
# PWA_SECRET_KEY y Unified_AK. Todo lo demás tiene defaults automáticos.

# ------------------------------------------------------------
# 1. VARIABLES ESENCIALES (OBLIGATORIAS)
# ------------------------------------------------------------

# Clave secreta para la firma criptográfica de tokens de sesión (HMAC-SHA256).
# Genera un token seguro con: python3 -c "import secrets; print(secrets.token_hex(32))"
PWA_SECRET_KEY=

# Clave unificada de FreeLLMAPI (o API key de proveedor OpenAI-compatible).
# Generada en el dashboard de FreeLLMAPI (formato freellmapi-...)
Unified_AK=

# ------------------------------------------------------------
# 2. VARIABLES OPCIONALES (TIENEN VALORES POR DEFECTO EN CÓDIGO)
# ------------------------------------------------------------

# URL base del proxy FreeLLMAPI (por defecto http://localhost:3001/v1)
# Descomentar si FreeLLMAPI corre en otra IP o si apuntas a un servicio cloud (Groq, OpenRouter, etc.)
# FREELLM_BASE_URL=http://localhost:3001/v1

# Puerto de escucha del servidor HTTP (por defecto 8010 en Orange Pi, 8000 en dev)
# APP_PORT=8010

# Contraseña compartida de acceso a la base de datos de la explotación (por defecto "ganaderos")
# PWA_PASSWORD=ganaderos

# Permitir descarga de la base de datos SQLite sin contraseña (1 = sí, 0 = no [recomendado])
# PWA_ALLOW_ANON_DB=0
