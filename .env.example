# ============================================================
# CONFIGURACIÓN DE ENTORNO - GANADEROS CAMPO PWA
# ============================================================

# Puerto de escucha del servidor HTTP (8010 en producción Orange Pi, 8000 en desarrollo)
APP_PORT=8010

# Seguridad de acceso a la base de datos de la explotación
# Establece una contraseña para restringir el acceso a la descarga del censo
PWA_PASSWORD=mvp-testing

# Clave secreta para la firma criptográfica de tokens de sesión (HMAC-SHA256)
# En producción, genera un token aleatorio de 64 caracteres hex:
# python3 -c "import secrets; print(secrets.token_hex(32))"
PWA_SECRET_KEY=

# Permitir consultas directas de IA sin autenticación previa (1 = sí, 0 = no)
# Recomendado 0 en servidores expuestos a internet
PWA_ALLOW_ANON_AI=0

# ============================================================
# PROVEEDOR DE MODELOS DE LENGUAJE (TEXT-TO-SQL) Y VOZ (WHISPER)
# ============================================================

# FreeLLMApi (Smart Router multi-proveedor unificado)
Unified_AK=your-FreeLLMApi-ak-here

# URL base del proxy FreeLLMApi (por defecto http://localhost:3001/v1)
FREELLM_BASE_URL=http://localhost:3001/v1
