# Snippet de configuración para Caddy v2 (/etc/caddy/Caddyfile)
# Soporta tanto subdominios dedicados (Cloudflare Zero Trust / alvaro137.com)
# como despliegues legados bajo subruta (/campo*).

# ==============================================================================
# 1. Configuración por Subdominios Dedicados (Producción alvaro137.com)
# ==============================================================================

http://campo.alvaro137.com {
    encode gzip
    # Redirección cruzada de subrutas legadas a sus respectivos subdominios
    redir /meteo* https://meteo.alvaro137.com{uri} 302
    redir /boxeo* https://boxeo.alvaro137.com{uri} 302

    @noCache {
        path /sw.js /index.html /manifest.json /
    }
    header @noCache Cache-Control "no-cache, no-store, must-revalidate"
    reverse_proxy 127.0.0.1:8010
}

http://meteo.alvaro137.com {
    encode gzip
    redir /campo* https://campo.alvaro137.com{uri} 302
    redir /boxeo* https://boxeo.alvaro137.com{uri} 302
    reverse_proxy 127.0.0.1:8000
}

http://boxeo.alvaro137.com {
    encode gzip
    redir /campo* https://campo.alvaro137.com{uri} 302
    redir /meteo* https://meteo.alvaro137.com{uri} 302
    reverse_proxy 127.0.0.1:8020
}

http://alvaro137.com, http://www.alvaro137.com {
    encode gzip
    redir /meteo* https://meteo.alvaro137.com{uri} 302
    redir /campo* https://campo.alvaro137.com{uri} 302
    redir /boxeo* https://boxeo.alvaro137.com{uri} 302
    redir / https://meteo.alvaro137.com 302
}

# ==============================================================================
# 2. Configuración por Subruta en Dominio Compartido (Compatibilidad /campo*)
# ==============================================================================

handle /campo* {
    # Eliminar prefijo /campo para reenviar limpiamente al backend FastAPI
    uri strip_prefix /campo

    reverse_proxy 127.0.0.1:8010 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Buffering optimizado para archivos grandes (base de datos SQLite)
        buffer_requests false
    }

    # Compresión acelerada para descarga en campo (SQLite WebAssembly y JS Modules)
    encode zstd gzip

    # Cabeceras de seguridad y soporte para Service Worker en subpath
    header {
        Service-Worker-Allowed "/campo/"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}
